@using Zeeyo.Web.ViewModels;
@model VerifyEmailOrPhoneNumberViewModel;

@{
	ViewData["Title"] = "Verify Email";
	Layout = "~/Views/Shared/_AccountLayout.cshtml";
}

<div class="account-container">
	<div class="account-box">
		<h2 class="text-center mb-4">Verify Email</h2>
		<form asp-action="VerifyEmailOrPhoneNumber" method="post">
			@Html.AntiForgeryToken()
			<div asp-validation-summary="ModelOnly" class="text-danger"> </div>
			<div class="mb-3" mt-3>
				<label asp-for="EmailOrPhoneNumber" class="form-label"></label>
				<input asp-for="EmailOrPhoneNumber" class="form-control" />
				<span asp-validation-for="EmailOrPhoneNumber" class="text-danger"></span>
			</div>
			<input type="submit" value="Send Code" class="btn btn-success w-100 p-2 mt-4" />
			<div class="text-center mt-4">
				<a asp-controller="Account" asp-action="Login" class="text-decoration-none mt-3">Back</a>
			</div>
		</form>
	</div>
</div>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
	}
}